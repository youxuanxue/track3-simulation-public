# Reproducible Python-only candidate on the preserved historical numeric stack.
# The inherited Cython sources must match; native edits require a full rebuild.
FROM ghcr.io/youxuanxue/track3-simulation-public@sha256:6701ee83bb02745831fd2fe923acfda938199eb5c128bafa0d5c827f452581fb
RUN sha256sum /opt/fast_sim/_native.pyx /opt/fast_sim/_hotpath.pyx > /opt/native-source.sha256
COPY baselines/fast_sim /opt/fast_sim
COPY baselines/abides_fork /opt/abides_fork
COPY simulate /usr/local/bin/simulate
COPY simulate-batch /usr/local/bin/simulate-batch
RUN sha256sum -c /opt/native-source.sha256
